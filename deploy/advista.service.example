[Unit]
Description=AdVista Agent Web Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=advista
Group=advista
WorkingDirectory=/opt/advista-agent
EnvironmentFile=/opt/advista-agent/.env
ExecStart=/opt/advista-agent/.venv/bin/advista-agent serve --config /opt/advista-agent/configs/production.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/advista-agent/outputs

[Install]
WantedBy=multi-user.target
